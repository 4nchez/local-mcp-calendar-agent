# 복사해서 사용: cp .env.example .env

# 사용할 로컬 LLM 모델 (ollama-init 컨테이너가 자동으로 내려받는다)
#   qwen2.5:3b       기본값. 한국어가 무난하고 CPU에서도 돌아간다 (약 2GB)
#   exaone3.5:2.4b   한국어 특화, 더 가볍다
#   llama3.1:8b      품질은 좋지만 8GB 이상 메모리 필요
OLLAMA_MODEL=qwen2.5:3b

# false로 두면 LLM 없이 규칙 + 템플릿 응답만으로 동작한다.
# 모델을 아직 못 받았거나 저사양 환경에서 데모할 때 사용.
LLM_ENABLED=true
LLM_TIMEOUT=45
LLM_KEEP_ALIVE=30m

# 호스트에 노출할 포트
DASHBOARD_PORT=3000
API_PORT=8001
MCP_SERVER_PORT=8002
MCP_CLIENT_PORT=8003
OLLAMA_PORT=11434
